#include <bits/stdc++.h>
using namespace std;

#define task "taptanh"
#define ll long long
#define Node pair<int, int>
#define F first
#define S second

const int maxN = 2e5 + 9;
const int MOD = 1e9 + 7;
const long long INF = 2e16;

struct Fenwick{
    int n;
    vector<int> bit;
    Fenwick(int N){
        n = N;
        bit.assign(N + 1, 0);
    }
    void update(int u, int v){
        for (; u <= n; u += u & (-u)) bit[u] += v;
    }
    int get(int u){
        int res = 0;
        for (; u > 0; u -= u & (-u)) res += bit[u];
        return res;
    }
    int query(int l, int r){
        return (l > 1 ? get(r) - get(l - 1) : get(r));
    }
};

bool nguyen_am(char x){
    return (x == 'a' || x == 'e' || x == 'u' || x == 'o' || x == 'i');
}

string s;
int n, k, a[maxN], lst[maxN];
ll N[maxN], P[maxN], X[maxN];
ll limleft[maxN], limright[maxN];
vector<ll> nen;

int Find(const vector<ll> &nen, ll v){
    return (lower_bound(nen.begin(), nen.end(), v)
            - nen.begin() + 1);
}

int binary(int right){
    int lo = 1, hi = right;
    int vt2 = 0, vt1 = 0;
    while (lo <= hi){
        int mid = (lo + hi) / 2;
        if (N[right] > N[mid]){
            vt1 = mid;
            lo = mid + 1;
        } else{
            hi = mid - 1;
        }
    }

    lo = 1; hi = right;
    while (lo <= hi){
        int mid = (lo + hi) / 2;
        if (P[right] > P[mid]){
            vt2 = mid;
            lo = mid + 1;
        } else{
            hi = mid - 1;
        }
    }
    return min(vt1, vt2);
}

signed main(){
	if (fopen(task".inp", "r")){
        freopen(task".inp", "r", stdin);
        freopen(task".out", "w", stdout);
    }
    ios_base::sync_with_stdio(false);
    cin.tie(NULL); cout.tie(NULL);

    cin >> s >> k; n = (int)s.size();
    s = " " + s;
    for (int i = 1; i <= n; i++){
        int x = int(s[i]);
        N[i] = N[i - 1];
        P[i] = P[i - 1];
        if (nguyen_am(s[i])) N[i] += x;
        else P[i] += x;
    }

    for (int i = 0; i <= n; i++){
        limleft[i] = P[i] - N[i];
        limright[i] = P[i] - N[i] + k;
        X[i] = P[i] - N[i];
        nen.push_back(X[i]);
        nen.push_back(limleft[i]);
        nen.push_back(limright[i]);
    }

    sort(nen.begin(), nen.end());
    nen.erase(unique(nen.begin(), nen.end()), nen.end());
    Fenwick fenw((int)nen.size());
    int pt1 = 0, pt2 = 0;
    ll res = 0;

    for (int i = 1; i <= n; i++){
        if (i == 1) lst[i] = 0;
        else if (nguyen_am(s[i]) != nguyen_am(s[i - 1])) lst[i] = i - 1;
        else lst[i] = lst[i - 1];
        int lim2 = binary(i);
        int lim1 = lst[lst[i]]; // Quan trọng: cận lim1 là lst[lst[i]] chứ KHÔNG PHẢI lst[lst[i]] + 1 
								// Bởi: Ta đang dùng công thức: sum[l -> r] = sum[1 -> r] - sum[1 -> l - 1]
								// Thực chất ta đang truy về các thẳng "l - 1" chứ không phải các thẳng "l" 
								// nên với lim1 = lst[lst[i]] thì l - 1 = lim1 <=> l = lim1 + 1 > lim1 
								// hay ko dính vào dãy đảo chiều 2 lần (nguyên âm -> phụ -> nguyên hoặc ngược lại) 
								// VD: aue bcd fg. Ký tự e ký chính lầ vị trí lst[lst[ký tự g]]  
//        cout << "i, lim1, lim2 = " << i << " " << lim1 << " " << lim2 << '\n';
        if (N[i] > 0 && P[i] > 0){ // Điều kiện này chặt hơn điều kiện lim2 > 0 như trong bài "Dãy số đẹp" có nói
            while (pt2 <= lim2){
                int id = Find(nen, X[pt2]);
                fenw.update(id, +1);
                pt2++;
            }
        }
        while (pt1 < lim1){
            int id = Find(nen, X[pt1]);
            fenw.update(id, -1);
            pt1++;
        }
        int L = Find(nen, limleft[i]);
        int R = Find(nen, limright[i]);
        int npair = fenw.query(L, R);
        res += npair;
    }
    cout << res << '\n';
	return 0;
}
