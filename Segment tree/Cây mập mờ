#include <bits/stdc++.h>
using namespace std;
// https://vjudge.net/contest/747141#overview
#define task "taptanh"
#define ll long long
#define Node pair<int, int>
#define F first
#define S second

const int maxN = 1e6 + 9;
const int MOD = 1e9 + 7;
const long long INF = 2e16;

struct Fenwick{
    int n;
    vector<int> bit;
    Fenwick(){};
    Fenwick(int N){
        n = N;
        bit.assign(N + 1, 0);
    }
    void update(int u, int v){
        for (; u <= n; u += u & (-u)) bit[u] += v;
    }
    void update_range(int l, int r, int delta){
        update(l, delta);
        if (r + 1 <= n) update(r + 1, -delta);
    }
    int num_par(int u){
        int res = 0;
        for (; u > 0; u -= u & (-u)) res += bit[u];
        return res;
    }
};

Fenwick fenw(maxN);
int n, a[maxN], b[maxN];
int inA[maxN], outA[maxN];
int rootA, rootB, timee;
ll res = 0;
vector<int> gA[maxN], gB[maxN];

void dfsA(int u, int p){
    inA[u] = ++timee;
    for (auto v : gA[u]) if (v != p){
        dfsA(v, u);
    }
    outA[u] = timee;
}

void dfsB(int u, int p){
    res += fenw.num_par(inA[u]);
    fenw.update_range(inA[u], outA[u], 1);
    for (auto v : gB[u]) if (v != p){
        dfsB(v, u);
    }
    fenw.update_range(inA[u], outA[u], -1);
}

signed main(){
	if (fopen(task".inp", "r")){
        freopen(task".inp", "r", stdin);
        freopen(task".out", "w", stdout);
    }
    ios_base::sync_with_stdio(false);
    cin.tie(NULL); cout.tie(NULL);

    cin >> n;
    for (int i = 1; i <= n; i++){
        cin >> a[i] >> b[i]; // a[i]: par[i]
        if (a[i] == -1) rootA = i;
        else{
            gA[i].push_back(a[i]);
            gA[a[i]].push_back(i);
        }
        if (b[i] == -1) rootB = i;
        else{
            gB[i].push_back(b[i]);
            gB[b[i]].push_back(i);
        }
    }
    dfsA(rootA, -1);
    dfsB(rootB, -1);
    cout << res << '\n';
	return 0;
}
